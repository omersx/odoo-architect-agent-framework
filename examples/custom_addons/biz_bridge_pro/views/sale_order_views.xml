<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_biz_bridge_pro" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.biz.bridge.pro</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_check_live_stock"
                    type="object"
                    string="Check Live Stock"
                    class="oe_highlight"
                    invisible="state not in ('draft', 'sent')"
                    groups="sales_team.group_sale_salesman"
                />
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="delivery_urgency"/>
            </xpath>
        </field>
    </record>
</odoo>
